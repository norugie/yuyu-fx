# Copy to .env and fill in. .env is gitignored; never commit it.

# Postgres connection string, e.g. postgres://yuyufx:<password>@localhost:5432/yuyufx
DATABASE_URL=
# Random string, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# API server port (default 3000)
PORT=
# Log out after this many idle minutes (default 30)
SESSION_IDLE_MINUTES=
# Dashboard origin allowed by CORS/CSRF checks (default http://127.0.0.1:5173).
# Use https://... when deployed; that also turns on the Secure cookie flag.
WEB_ORIGIN=
# Pretend cash the paper account starts with, in CAD (default 100000)
PAPER_STARTING_CASH=
# 64 hex characters (32 bytes) that encrypt stored API credentials. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it: losing it means pasting a new Questrade token.
SECRETS_KEY=
# Questrade API refresh token (personal app, read-only scopes). Used once; after that
# the rotated token is stored encrypted in the database.
QUESTRADE_REFRESH_TOKEN=
# TSX symbols to keep daily bars for, comma-separated (default XIU)
MARKET_DATA_SYMBOLS=
